# Copy to .env (never commit .env)

# --- Planes: OpenSky Network (OAuth2 client credentials) ---
# Optional. Without these the app still shows planes using OpenSky's anonymous access,
# which has a much smaller allowance (see OPENSKY_ANON_POLL_SECONDS).
# To get them: log in at opensky-network.org > Account page > create an API client.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Seconds between polls when signed in. Free registered tier is ~4,000 credits/day, so keep this high.
OPENSKY_POLL_SECONDS=120
# Seconds between polls when anonymous (no credentials). Deliberately slow.
OPENSKY_ANON_POLL_SECONDS=900

# --- Ships: AISStream (free key from aisstream.io) ---
AISSTREAM_API_KEY=
# Which sea areas to follow (comma-separated). Ships only appear inside these areas, so a short list
# means ships bunched in a few spots. `world` follows everything (the map copes with tens of thousands of
# ships, but AISStream's coverage is patchy, mostly near coasts).
# Presets: english-channel, north-sea, baltic, mediterranean, gibraltar, suez, red-sea, hormuz, india-west,
#          malacca, east-china-sea, japan, us-west-coast, us-east-coast, gulf-of-mexico, panama, brazil,
#          west-africa, australia-east, world
AIS_REGIONS=north-sea,mediterranean,suez,hormuz,malacca,east-china-sea,us-east-coast,us-west-coast

# --- Server ---
PORT=3001
# fixtures = replay recorded/sample data (no keys needed)
# live     = use OpenSky + AISStream
DATA_MODE=fixtures
